# FraudScope environment configuration (copy to .env and edit as needed)

# Path to the trained model artifact
MODEL_PATH=models/fraud_model_v1.joblib
MODEL_METADATA_PATH=models/metadata.json

# Path to the dataset used for training/evaluation
# NOTE: this must point at a PUBLIC / SYNTHETIC dataset only. Never point this
# at real bank or customer transaction data.
DATA_PATH=data/creditcard.csv

# Risk band thresholds (probability of fraud, 0-1)
RISK_LOW_MAX=0.3
RISK_MEDIUM_MAX=0.7

# Service
LOG_LEVEL=INFO
MODEL_VERSION=v1
